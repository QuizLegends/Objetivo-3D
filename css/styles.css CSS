:root {
  /* === Tema Azul Escuro Profissional === */
  --bg: #0b0f1a;
  --bg-panel: #111827;
  --bg-hover: #1a2236;
  --bg-active: #243049;
  --border: #1e2a44;
  --border-light: #2a3b5c;
  --text: #e8eef8;
  --text-muted: #8b9bb8;
  --primary: #3b82f6;
  --primary-hover: #2563eb;
  --primary-active: #1d4ed8;
  --accent: #06b6d4;
  --accent-hover: #0891b2;
  --danger: #ef4444;
  --success: #22c55e;
  --radius: 8px;
  --radius-sm: 6px;
  --shadow: 0 4px 12px rgba(0, 0, 0, 0.4);
  --font: "Inter", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  height: 100%;
  overflow: hidden;
  font-family: var(--font);
  background: var(--bg);
  color: var(--text);
  font-size: 13px;
  -webkit-font-smoothing: antialiased;
}

#app {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* ===================== TOOLBAR ===================== */
#toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 48px;
  padding: 0 14px;
  background: linear-gradient(180deg, #141c2e 0%, #111827 100%);
  border-bottom: 1px solid var(--border);
  gap: 12px;
  flex-shrink: 0;
  z-index: 20;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
}

.toolbar-left,
.toolbar-center,
.toolbar-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.logo {
  font-weight: 700;
  font-size: 15px;
  margin-right: 10px;
  white-space: nowrap;
  color: #93c5fd;
  letter-spacing: -0.3px;
}

/* ===================== BOTÕES ===================== */
.btn {
  background: var(--bg-hover);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 7px 14px;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.15s ease;
  white-space: nowrap;
  user-select: none;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
}

.btn:hover {
  background: var(--bg-active);
  border-color: var(--border-light);
  transform: translateY(-1px);
}

.btn:active {
  transform: translateY(1px) scale(0.97);
  box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.35);
  background: #1a2438;
}

.btn.primary {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
  box-shadow: 0 2px 6px rgba(59, 130, 246, 0.35);
}

.btn.primary:hover {
  background: var(--primary-hover);
  border-color: var(--primary-hover);
  transform: translateY(-1px);
}

.btn.primary:active {
  background: var(--primary-active);
  transform: translateY(1px) scale(0.97);
  box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.3);
}

.btn.accent {
  background: var(--accent);
  border-color: var(--accent);
  color: #042f2e;
  font-weight: 600;
  box-shadow: 0 2px 6px rgba(6, 182, 212, 0.3);
}

.btn.accent:hover {
  background: var(--accent-hover);
  border-color: var(--accent-hover);
  transform: translateY(-1px);
}

.btn.accent:active {
  transform: translateY(1px) scale(0.97);
  box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.25);
}

.btn.small {
  padding: 5px 10px;
  font-size: 11px;
}

/* Botões de ícone */
.btn-icon {
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-hover);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text);
  cursor: pointer;
  font-size: 14px;
  transition: all 0.15s ease;
  user-select: none;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
}

.btn-icon:hover {
  background: var(--bg-active);
  border-color: var(--primary);
  color: var(--primary);
  transform: translateY(-1px);
}

.btn-icon:active {
  transform: translateY(1px) scale(0.94);
  box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.35);
}

.btn-icon.active {
  background: rgba(59, 130, 246, 0.15);
  border-color: var(--primary);
  color: var(--primary);
  box-shadow: 0 0 0 1px rgba(59, 130, 246, 0.3);
}

.transform-modes {
  display: flex;
  gap: 4px;
}

/* ===================== LAYOUT PRINCIPAL ===================== */
#main {
  display: flex;
  flex: 1;
  overflow: hidden;
  position: relative;
}

.panel {
  width: 270px;
  background: var(--bg-panel);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  flex-shrink: 0;
}

#panel-right {
  border-right: none;
  border-left: 1px solid var(--border);
}

/* ===================== TABS ===================== */
.panel-tabs {
  display: flex;
  border-bottom: 1px solid var(--border);
  background: #0d1424;
}

.tab {
  flex: 1;
  padding: 11px 8px;
  background: transparent;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  font-size: 12px;
  font-weight: 500;
  transition: all 0.15s ease;
  user-select: none;
}

.tab:hover {
  color: var(--text);
  background: rgba(59, 130, 246, 0.08);
}

.tab:active {
  transform: scale(0.97);
}

.tab.active {
  color: #93c5fd;
  background: var(--bg-hover);
  border-bottom: 2px solid var(--primary);
}

.tab-content {
  display: none;
  flex: 1;
  overflow-y: auto;
  padding: 10px;
}

.tab-content.active {
  display: flex;
  flex-direction: column;
}

/* ===================== SEARCH ===================== */
.search-box {
  margin-bottom: 10px;
}

.search-box input {
  width: 100%;
  padding: 8px 12px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  color: var(--text);
  font-size: 12px;
  transition: border-color 0.15s;
}

.search-box input:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
}

/* ===================== LISTAS ===================== */
.tree, .list {
  list-style: none;
}

.tree li, .list li {
  padding: 8px 10px;
  border-radius: 6px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  user-select: none;
  transition: background 0.12s ease;
}

.tree li:hover, .list li:hover {
  background: var(--bg-hover);
}

.tree li:active, .list li:active {
  transform: scale(0.98);
}

.tree li.selected, .list li.selected {
  background: rgba(59, 130, 246, 0.18);
  color: #93c5fd;
  border: 1px solid rgba(59, 130, 246, 0.25);
}

.tree .children {
  padding-left: 16px;
}

.tree .toggle {
  width: 14px;
  text-align: center;
  color: var(--text-muted);
  font-size: 10px;
}

.muted {
  color: var(--text-muted);
  font-size: 12px;
  padding: 8px;
}

/* ===================== VIEWPORT ===================== */
#viewport-container {
  flex: 1;
  position: relative;
  background: #070b14;
  overflow: hidden;
}

#canvas {
  width: 100%;
  height: 100%;
  display: block;
  outline: none;
}

#viewport-overlay {
  position: absolute;
  top: 12px;
  left: 12px;
  pointer-events: none;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.hud {
  background: rgba(11, 15, 26, 0.75);
  backdrop-filter: blur(8px);
  padding: 5px 10px;
  border-radius: 6px;
  font-size: 11px;
  color: #a5b4c8;
  border: 1px solid rgba(30, 42, 68, 0.6);
}

#viewport-controls {
  position: absolute;
  bottom: 14px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 6px;
  background: rgba(17, 24, 39, 0.9);
  backdrop-filter: blur(10px);
  padding: 7px;
  border-radius: 10px;
  border: 1px solid var(--border);
  align-items: center;
  box-shadow: var(--shadow);
}

/* Brightness control */
.brightness-control {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-left: 8px;
  padding-left: 8px;
  border-left: 1px solid var(--border);
}

.brightness-label {
  min-width: 42px;
  text-align: center;
  font-size: 11px;
  color: var(--text-muted);
  user-select: none;
}

/* ===================== PAINEL DIREITO ===================== */
.panel-section {
  padding: 14px;
  border-bottom: 1px solid var(--border);
}

.panel-section h3 {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  color: var(--text-muted);
  margin-bottom: 12px;
  font-weight: 600;
}

.prop-row {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
  gap: 6px;
}

.prop-row label {
  width: 58px;
  color: var(--text-muted);
  font-size: 11px;
  font-weight: 500;
}

.prop-row input[type="text"],
.prop-row input[type="number"] {
  flex: 1;
  padding: 6px 8px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 5px;
  color: var(--text);
  font-size: 12px;
  transition: border-color 0.15s;
}

.prop-row input:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.15);
}

.vec3 {
  display: flex;
  gap: 4px;
  flex: 1;
}

.vec3 input {
  width: 0;
  flex: 1;
  text-align: center;
}

.checkbox {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 7px;
  cursor: pointer;
  font-size: 12px;
  user-select: none;
}

.checkbox:active {
  opacity: 0.8;
}

.checkbox input {
  accent-color: var(--primary);
  width: 15px;
  height: 15px;
}

/* ===================== ANIMAÇÕES ===================== */
#anim-controls {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 10px;
}

#anim-controls.hidden {
  display: none;
}

#anim-slider {
  flex: 1;
  accent-color: var(--primary);
}

.anim-item {
  padding: 8px 10px;
  border-radius: 6px;
  cursor: pointer;
  margin-bottom: 3px;
  transition: all 0.12s ease;
  user-select: none;
}

.anim-item:hover {
  background: var(--bg-hover);
}

.anim-item:active {
  transform: scale(0.98);
}

.anim-item.active {
  background: rgba(6, 182, 212, 0.15);
  color: var(--accent);
  border: 1px solid rgba(6, 182, 212, 0.3);
}

/* ===================== MOBILE ===================== */
#mobile-toggles {
  display: none;
  position: fixed;
  bottom: 16px;
  right: 16px;
  gap: 8px;
  z-index: 30;
}

@media (max-width: 900px) {
  .panel {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 25;
    width: 290px;
    transform: translateX(-100%);
    transition: transform 0.25s ease;
    box-shadow: 4px 0 20px rgba(0, 0, 0, 0.5);
  }

  #panel-left.open {
    transform: translateX(0);
  }

  #panel-right {
    right: 0;
    left: auto;
    transform: translateX(100%);
  }

  #panel-right.open {
    transform: translateX(0);
  }

  #mobile-toggles {
    display: flex;
  }

  .toolbar-center {
    display: none;
  }

  .logo {
    font-size: 13px;
  }

  .btn {
    padding: 6px 10px;
    font-size: 11px;
  }
}

/* ===================== SCROLLBAR ===================== */
::-webkit-scrollbar {
  width: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: #1e2a44;
  border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover {
  background: #2a3b5c;
}
