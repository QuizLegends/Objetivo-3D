/* ─── Reset & Base ─────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg:          #0a1220;
  --bg-panel:    #0f1c2e;
  --bg-input:    #152536;
  --border:      #1e3a5f;
  --accent:      #3b82f6;
  --accent-hover:#2563eb;
  --text:        #e2e8f0;
  --text-muted:  #94a3b8;
  --danger:      #ef4444;
  --success:     #22c55e;
  --radius:      8px;
  --font:        'Segoe UI', system-ui, -apple-system, sans-serif;
}

html, body {
  height: 100%;
  font-family: var(--font);
  background: var(--bg);
  color: var(--text);
  overflow: hidden;
}

#app {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* ─── Toolbar ──────────────────────────────────────────────── */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 16px;
  background: var(--bg-panel);
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
  z-index: 10;
}

.logo {
  font-size: 1rem;
  font-weight: 600;
  color: var(--accent);
  white-space: nowrap;
}

.toolbar-center {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: center;
}

.toolbar-right {
  min-width: 120px;
  text-align: right;
}

.status {
  font-size: 0.8rem;
  color: var(--text-muted);
}

/* ─── Main layout ──────────────────────────────────────────── */
.main {
  display: flex;
  flex: 1;
  min-height: 0;
}

.viewport {
  flex: 1;
  position: relative;
  background: #0d1b2a;
  min-width: 0;
}

.viewport canvas {
  display: block;
  width: 100% !important;
  height: 100% !important;
}

/* ─── Side panel ───────────────────────────────────────────── */
.panel {
  width: 280px;
  flex-shrink: 0;
  background: var(--bg-panel);
  border-left: 1px solid var(--border);
  overflow-y: auto;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.panel-section h2 {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-muted);
  margin-bottom: 8px;
}

/* ─── Buttons ──────────────────────────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px 14px;
  font-size: 0.85rem;
  font-weight: 500;
  border: none;
  border-radius: var(--radius);
  cursor: pointer;
  transition: background 0.15s, opacity 0.15s;
  color: #fff;
  white-space: nowrap;
}

.btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.btn-primary {
  background: var(--accent);
}
.btn-primary:hover:not(:disabled) {
  background: var(--accent-hover);
}

.btn-secondary {
  background: #1e3a5f;
}
.btn-secondary:hover:not(:disabled) {
  background: #254a75;
}

.btn-ghost {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text);
}
.btn-ghost:hover:not(:disabled) {
  background: var(--bg-input);
}

.btn-danger {
  background: transparent;
  border: 1px solid var(--danger);
  color: var(--danger);
}
.btn-danger:hover:not(:disabled) {
  background: rgba(239, 68, 68, 0.15);
}

.btn-block {
  width: 100%;
  margin-top: 6px;
}

.btn-row {
  display: flex;
  gap: 8px;
}
.btn-row .btn {
  flex: 1;
}

/* ─── Form controls ────────────────────────────────────────── */
.label {
  display: block;
  font-size: 0.78rem;
  color: var(--text-muted);
  margin: 8px 0 4px;
}

.select, .input-num {
  width: 100%;
  padding: 7px 10px;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 0.85rem;
  outline: none;
  transition: border-color 0.15s;
}

.select:focus, .input-num:focus {
  border-color: var(--accent);
}

.select:disabled, .input-num:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.xyz {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 6px;
}

.xyz-item {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.xyz-item span {
  font-size: 0.7rem;
  color: var(--text-muted);
  text-align: center;
}

.xyz-item .input-num {
  text-align: center;
  padding: 6px 4px;
}

.size-row {
  display: flex;
  align-items: center;
  gap: 6px;
}

.size-row .input-num {
  flex: 1;
}

.unit {
  font-size: 0.85rem;
  color: var(--text-muted);
}

.hint {
  font-size: 0.72rem;
  color: var(--text-muted);
  margin-top: 4px;
}

/* ─── Radio ────────────────────────────────────────────────── */
.radio-group {
  display: flex;
  gap: 12px;
}

.radio {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.85rem;
  cursor: pointer;
}

.radio input {
  accent-color: var(--accent);
}

/* ─── Loading ──────────────────────────────────────────────── */
.loading {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  background: rgba(10, 18, 32, 0.75);
  z-index: 5;
  font-size: 0.9rem;
  color: var(--text-muted);
}

.loading.hidden {
  display: none;
}

.spinner {
  width: 36px;
  height: 36px;
  border: 3px solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ─── Scrollbar ────────────────────────────────────────────── */
.panel::-webkit-scrollbar {
  width: 6px;
}
.panel::-webkit-scrollbar-track {
  background: transparent;
}
.panel::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 3px;
}

/* ─── Responsive ───────────────────────────────────────────── */
@media (max-width: 700px) {
  .main {
    flex-direction: column;
  }
  .panel {
    width: 100%;
    max-height: 40vh;
    border-left: none;
    border-top: 1px solid var(--border);
  }
  .logo {
    display: none;
  }
}
