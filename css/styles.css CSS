:root {
  --bg: #0f1115;
  --bg-panel: #161a21;
  --bg-hover: #1e2430;
  --bg-active: #252c3a;
  --border: #2a3140;
  --text: #e6eaf0;
  --text-muted: #8b93a7;
  --primary: #4f8cff;
  --primary-hover: #3a7aef;
  --accent: #00c2a8;
  --accent-hover: #00a890;
  --danger: #ff5c5c;
  --success: #3dd68c;
  --radius: 6px;
  --font: "Inter", system-ui, -apple-system, sans-serif;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body {
  height: 100%;
  overflow: hidden;
  font-family: var(--font);
  background: var(--bg);
  color: var(--text);
  font-size: 13px;
}

#app {
  display: flex;
  flex-direction: column;
  height: 100%;
}

/* Toolbar */
#toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44px;
  padding: 0 12px;
  background: var(--bg-panel);
  border-bottom: 1px solid var(--border);
  gap: 12px;
  flex-shrink: 0;
  z-index: 20;
}

.toolbar-left, .toolbar-center, .toolbar-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.logo {
  font-weight: 700;
  font-size: 15px;
  margin-right: 8px;
  white-space: nowrap;
}

.btn {
  background: var(--bg-hover);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 6px 12px;
  font-size: 12px;
  cursor: pointer;
  transition: background 0.15s, border-color 0.15s;
  white-space: nowrap;
}

.btn:hover {
  background: var(--bg-active);
  border-color: #3a4558;
}

.btn.primary {
  background: var(--primary);
  border-color: var(--primary);
  color: #fff;
}

.btn.primary:hover {
  background: var(--primary-hover);
}

.btn.accent {
  background: var(--accent);
  border-color: var(--accent);
  color: #000;
  font-weight: 600;
}

.btn.accent:hover {
  background: var(--accent-hover);
}

.btn.small {
  padding: 4px 8px;
  font-size: 11px;
}

.btn-icon {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-hover);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  cursor: pointer;
  font-size: 14px;
  transition: background 0.15s;
}

.btn-icon:hover, .btn-icon.active {
  background: var(--bg-active);
  border-color: var(--primary);
  color: var(--primary);
}

.transform-modes {
  display: flex;
  gap: 4px;
}

/* Main layout */
#main {
  display: flex;
  flex: 1;
  overflow: hidden;
  position: relative;
}

.panel {
  width: 260px;
  background: var(--bg-panel);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  flex-shrink: 0;
}

#panel-right {
  border-right: none;
  border-left: 1px solid var(--border);
}

.panel-tabs {
  display: flex;
  border-bottom: 1px solid var(--border);
}

.tab {
  flex: 1;
  padding: 10px;
  background: transparent;
  border: none;
  color: var(--text-muted);
  cursor: pointer;
  font-size: 12px;
  font-weight: 500;
}

.tab.active {
  color: var(--text);
  background: var(--bg-hover);
  border-bottom: 2px solid var(--primary);
}

.tab-content {
  display: none;
  flex: 1;
  overflow-y: auto;
  padding: 8px;
}

.tab-content.active {
  display: flex;
  flex-direction: column;
}

.search-box {
  margin-bottom: 8px;
}

.search-box input {
  width: 100%;
  padding: 7px 10px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--text);
  font-size: 12px;
}

.search-box input:focus {
  outline: none;
  border-color: var(--primary);
}

/* Tree / List */
.tree, .list {
  list-style: none;
}

.tree li, .list li {
  padding: 5px 8px;
  border-radius: 4px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  user-select: none;
}

.tree li:hover, .list li:hover {
  background: var(--bg-hover);
}

.tree li.selected, .list li.selected {
  background: var(--bg-active);
  color: var(--primary);
}

.tree .children {
  padding-left: 16px;
}

.tree .toggle {
  width: 14px;
  text-align: center;
  color: var(--text-muted);
  font-size: 10px;
}

.muted {
  color: var(--text-muted);
  font-size: 12px;
  padding: 8px;
}

/* Viewport */
#viewport-container {
  flex: 1;
  position: relative;
  background: #0a0c10;
  overflow: hidden;
}

#canvas {
  width: 100%;
  height: 100%;
  display: block;
  outline: none;
}

#viewport-overlay {
  position: absolute;
  top: 10px;
  left: 10px;
  pointer-events: none;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.hud {
  background: rgba(0,0,0,0.55);
  padding: 4px 8px;
  border-radius: 4px;
  font-size: 11px;
  color: #ccc;
}

#viewport-controls {
  position: absolute;
  bottom: 12px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 6px;
  background: rgba(22,26,33,0.85);
  padding: 6px;
  border-radius: 8px;
  border: 1px solid var(--border);
  align-items: center;
}

/* Brightness control */
.brightness-control {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-left: 8px;
  padding-left: 8px;
  border-left: 1px solid var(--border);
}

.brightness-label {
  min-width: 42px;
  text-align: center;
  font-size: 11px;
  color: var(--text-muted);
  user-select: none;
}

/* Right panel sections */
.panel-section {
  padding: 12px;
  border-bottom: 1px solid var(--border);
}

.panel-section h3 {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  color: var(--text-muted);
  margin-bottom: 10px;
}

.prop-row {
  display: flex;
  align-items: center;
  margin-bottom: 6px;
  gap: 6px;
}

.prop-row label {
  width: 55px;
  color: var(--text-muted);
  font-size: 11px;
}

.prop-row input[type="text"],
.prop-row input[type="number"] {
  flex: 1;
  padding: 5px 7px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 4px;
  color: var(--text);
  font-size: 12px;
}

.prop-row input:focus {
  outline: none;
  border-color: var(--primary);
}

.vec3 {
  display: flex;
  gap: 4px;
  flex: 1;
}

.vec3 input {
  width: 0;
  flex: 1;
  text-align: center;
}

.checkbox {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 6px;
  cursor: pointer;
  font-size: 12px;
}

.checkbox input {
  accent-color: var(--primary);
}

#anim-controls {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 8px;
}

#anim-controls.hidden {
  display: none;
}

#anim-slider {
  flex: 1;
  accent-color: var(--primary);
}

.anim-item {
  padding: 6px 8px;
  border-radius: 4px;
  cursor: pointer;
  margin-bottom: 2px;
}

.anim-item:hover {
  background: var(--bg-hover);
}

.anim-item.active {
  background: var(--bg-active);
  color: var(--accent);
}

/* Mobile */
#mobile-toggles {
  display: none;
  position: fixed;
  bottom: 16px;
  right: 16px;
  gap: 8px;
  z-index: 30;
}

@media (max-width: 900px) {
  .panel {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 25;
    width: 280px;
    transform: translateX(-100%);
    transition: transform 0.25s ease;
  }

  #panel-left.open {
    transform: translateX(0);
  }

  #panel-right {
    right: 0;
    left: auto;
    transform: translateX(100%);
  }

  #panel-right.open {
    transform: translateX(0);
  }

  #mobile-toggles {
    display: flex;
  }

  .toolbar-center {
    display: none;
  }

  .logo {
    font-size: 13px;
  }

  .btn {
    padding: 5px 8px;
    font-size: 11px;
  }
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: #333a48;
  border-radius: 3px;
}
